.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# OS
.DS_Store

# Front end
web/node_modules/
web/dist/
web/.vite/
web/*.tsbuildinfo

# Scheduler output. Local noise, and it can echo league ids.
data/logs/
